---
// Brochure value strip: "What Your Support Provides" — Food, Education, Healthcare, Shelter, Protection.
const svgWrap = (inner: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;

const provides = [
  { label: "Food", svg: svgWrap(`<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>`) },
  { label: "Education", svg: svgWrap(`<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>`) },
  { label: "Healthcare", svg: svgWrap(`<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>`) },
  { label: "Shelter", svg: svgWrap(`<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>`) },
  { label: "Protection", svg: svgWrap(`<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`) },
];
---

<section id="provides" class="relative py-20 md:py-24 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Intro -->
    <div class="animate-in-element text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0d47a1]/8 border border-[#0d47a1]/15 text-[#0d47a1] text-xs font-[Montserrat] font-semibold tracking-widest uppercase mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FFB300] inline-block"></span>
        What Your Support Provides
      </span>
      <h2 class="font-[Montserrat] font-semibold text-[#263238] leading-[1.1] tracking-[-0.02em]" style="font-size: clamp(1.9rem, 4vw, 3rem)">
        Essential care, education &amp; hope<br class="hidden sm:block" />
        <span class="text-[#0d47a1]">for a brighter tomorrow</span>
      </h2>
    </div>

    <!-- Icon strip -->
    <div class="flex flex-wrap justify-center gap-4 md:gap-6">
      {provides.map((p, i) => (
        <div
          class="animate-in-element group w-[140px] md:w-[170px] flex flex-col items-center text-center gap-4 p-6 rounded-2xl border border-[#263238]/8 bg-[#f8f9fa] hover:bg-white hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-300"
          style={`transition-delay: ${i * 70}ms`}
        >
          <div
            class="w-14 h-14 rounded-2xl bg-[#0d47a1]/8 text-[#0d47a1] flex items-center justify-center group-hover:bg-[#0d47a1] group-hover:text-white transition-colors duration-300"
            set:html={p.svg}
          ></div>
          <span class="text-sm md:text-base font-[Montserrat] font-semibold text-[#263238]">{p.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.1, rootMargin: '-40px' }
  );
  document.querySelectorAll('#provides .animate-in-element').forEach(el => observer.observe(el));
</script>
