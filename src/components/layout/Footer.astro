---
---

<footer class="bg-[#263238] text-white">
  <!-- Impact strip -->
  <div class="border-b border-white/8 bg-[#1e2d34]">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
        <div class="text-center">
          <div class="text-3xl font-[Satoshi] font-semibold text-[#FFB300]">9</div>
          <div class="text-xs text-white/90 font-medium tracking-widest uppercase mt-1">Countries</div>
        </div>
        <div class="w-px h-10 bg-white/10 hidden md:block"></div>
        <div class="text-center">
          <div class="text-3xl font-[Satoshi] font-semibold text-[#FFB300]">$33</div>
          <div class="text-xs text-white/90 font-medium tracking-widest uppercase mt-1">Starting / Month</div>
        </div>
        <div class="w-px h-10 bg-white/10 hidden md:block"></div>
        <div class="text-center">
          <div class="text-3xl font-[Satoshi] font-semibold text-[#FFB300]">100%</div>
          <div class="text-xs text-white/90 font-medium tracking-widest uppercase mt-1">To Orphan Care</div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-14">
      <!-- Brand (wider) -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-5">
          <img src="/logo.png" alt="Orphan Aid" width="144" height="56" class="h-14 w-auto" />
        </div>
        <p class="text-white/90 leading-[1.7] text-sm max-w-sm mb-6">
          A registered Canadian charity building a global network of care for
          orphaned children — one sponsor at a time. Every dollar goes where it matters most.
        </p>

        <!-- Email updates -->
        <div class="flex gap-2 max-w-sm">
          <label for="footer-email" class="sr-only">Email address for updates</label>
          <input
            id="footer-email"
            type="email"
            placeholder="Your email address"
            class="flex-1 bg-white/6 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#FFB300]/50 transition-colors"
          />
          <button class="bg-[#FFB300] text-[#263238] px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-[#e6a100] transition-colors shrink-0">
            Subscribe
          </button>
        </div>

        <div class="mt-5 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/8 text-white/90 text-xs font-medium">
          🇨🇦 Registered Canadian Charitable Organization
        </div>
      </div>

      <!-- Spacer -->
      <div class="md:col-span-1"></div>

      <!-- Navigation -->
      <div class="md:col-span-2">
        <h3 class="text-[10px] font-bold tracking-widest uppercase text-white/90 mb-5">Navigation</h3>
        <ul class="space-y-3.5">
          {[
            { label: "Mission", href: "#mission" },
            { label: "Our Reach", href: "#reach" },
            { label: "Sponsor", href: "#sponsor" },
            { label: "Why Us", href: "#why" },
            { label: "FAQ", href: "#faq" },
          ].map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/90 hover:text-white transition-colors duration-200 flex items-center gap-2 group"
              >
                <span class="w-0 group-hover:w-3 h-px bg-[#FFB300] transition-all duration-200 inline-block"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Social -->
      <div class="md:col-span-4">
        <h3 class="text-[10px] font-bold tracking-widest uppercase text-white/90 mb-5">Connect</h3>
        <ul class="space-y-3.5">
          <li>
            <a href="mailto:info@orphanaid.ca" class="text-sm text-white/90 hover:text-white transition-colors duration-200 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              info@orphanaid.ca
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/8 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/90 text-sm">
        © {new Date().getFullYear()} Orphan Aid. All rights reserved.
      </p>
      <p class="text-white/90 text-xs text-center sm:text-right">
        Built with care to serve the world's most vulnerable children.
      </p>
    </div>
  </div>
</footer>
